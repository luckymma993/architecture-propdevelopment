<mxfile host="drawio" type="device"><diagram name="Безопасность данных" id="mindmap"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Безопасность данных&lt;/b&gt;&lt;br&gt;PropDevelopment" style="ellipse;whiteSpace=wrap;html=1;fontSize=16;fillColor=#1e4e8c;fontColor=#ffffff;strokeColor=#10325c;" vertex="1" parent="1"><mxGeometry x="-120" y="-55" width="240" height="110" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="-733" width="170" height="50" as="geometry"/></mxCell><mxCell id="n3" value="Неверная цена или статус квартиры на витрине ведут к ошибочным бронированиям, претензиям клиентов и спорам о цене предложения." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-733" width="430" height="50" as="geometry"/></mxCell><mxCell id="e4" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="-667" width="170" height="50" as="geometry"/></mxCell><mxCell id="n6" value="Каталог публикуется в client-mart-app через Kafka. При рассинхронизации проданная квартира остаётся доступной, возможны двойные бронирования." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-671" width="430" height="59" as="geometry"/></mxCell><mxCell id="e7" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="Каталог объектов недвижимости: описания, планировки, цены, статусы&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;client-mart-estate-db, витрина продаж&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-740" y="-710" width="240" height="70" as="geometry"/></mxCell><mxCell id="e9" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n8" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n8" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="-588" width="170" height="50" as="geometry"/></mxCell><mxCell id="n12" value="3D-туры дорого и долго создавать заново. Без них клиент не может осмотреть объект удалённо, компания теряет продажи." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-588" width="430" height="50" as="geometry"/></mxCell><mxCell id="e13" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Обесценивание&lt;/b&gt;&lt;br&gt;незначительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1f5e1;strokeColor=#5aa05a;" vertex="1" parent="1"><mxGeometry x="-985" y="-526" width="170" height="50" as="geometry"/></mxCell><mxCell id="n15" value="Тур устаревает после изменений на объекте, но обновляется штатно и на сделку не влияет." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-526" width="430" height="50" as="geometry"/></mxCell><mxCell id="e16" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="Контент онлайн-туров: 3D-модели и фото объектов&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;client-tour-db&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-740" y="-567" width="240" height="70" as="geometry"/></mxCell><mxCell id="e18" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n17" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n17" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="-452" width="170" height="50" as="geometry"/></mxCell><mxCell id="n21" value="Подменённое объявление (например, «оплатите по новым реквизитам») может обмануть жильцов и подорвать доверие к приложению." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-452" width="430" height="50" as="geometry"/></mxCell><mxCell id="e22" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;незначительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1f5e1;strokeColor=#5aa05a;" vertex="1" parent="1"><mxGeometry x="-985" y="-390" width="170" height="50" as="geometry"/></mxCell><mxCell id="n24" value="Объявления легко восстановить или опубликовать повторно." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-390" width="430" height="50" as="geometry"/></mxCell><mxCell id="e25" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="Новости и объявления управляющей компании&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;tenant-core-app, мобильное приложение&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-740" y="-431" width="240" height="70" as="geometry"/></mxCell><mxCell id="e27" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n26" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n26" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Публичные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-430" y="-565" width="200" height="60" as="geometry"/></mxCell><mxCell id="e30" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n1" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n29" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n29" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n29" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-985" y="-261" width="170" height="50" as="geometry"/></mxCell><mxCell id="n35" value="Персональные данные по 152-ФЗ: штрафы и репутационный ущерб, как у конкурента. Точек регистрации несколько, доступ в системах обработки данных не ограничен." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-266" width="430" height="59" as="geometry"/></mxCell><mxCell id="e36" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n34" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-985" y="-195" width="170" height="50" as="geometry"/></mxCell><mxCell id="n38" value="Дубли клиента из разных точек регистрации и ошибочная склейка профилей — вероятная причина показа чужого ФИО в личном кабинете." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-195" width="430" height="50" as="geometry"/></mxCell><mxCell id="e39" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n37" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="-133" width="170" height="50" as="geometry"/></mxCell><mxCell id="n41" value="Неверные контакты клиента срывают бронирование и онлайн-сделку." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-133" width="430" height="50" as="geometry"/></mxCell><mxCell id="e42" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n40" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="Персональные данные клиентов: ФИО, телефон, email, профиль&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;client-crm-app, crm-db, витрина продаж&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-740" y="-207" width="240" height="70" as="geometry"/></mxCell><mxCell id="e44" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n43" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e45" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n43" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e46" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n43" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-985" y="-59" width="170" height="50" as="geometry"/></mxCell><mxCell id="n48" value="Через API партнёров управляющая компания может видеть данные жильцов другой компании. Это нарушение 152-ФЗ." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="-59" width="430" height="50" as="geometry"/></mxCell><mxCell id="e49" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n47" target="n48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="3" width="170" height="50" as="geometry"/></mxCell><mxCell id="n51" value="Контракты API позволяют партнёру изменять данные чужих клиентов и жилых комплексов." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="3" width="430" height="50" as="geometry"/></mxCell><mxCell id="e52" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n50" target="n51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="Персональные данные собственников: ФИО, адрес, квартира, лицевой счёт&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;CRM ЖКУ, crm-tenant-db&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-740" y="-38" width="240" height="70" as="geometry"/></mxCell><mxCell id="e54" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n53" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e55" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n53" target="n50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-985" y="77" width="170" height="50" as="geometry"/></mxCell><mxCell id="n57" value="Неверные начисления — прямые финансовые потери и жалобы. Данные изменяются через API партнёров без системного контроля." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="77" width="430" height="50" as="geometry"/></mxCell><mxCell id="e58" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n56" target="n57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n59" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="139" width="170" height="50" as="geometry"/></mxCell><mxCell id="n60" value="Без истории платежей нельзя подтвердить оплату, появляются спорные долги." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="139" width="430" height="50" as="geometry"/></mxCell><mxCell id="e61" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n59" target="n60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n62" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="201" width="170" height="50" as="geometry"/></mxCell><mxCell id="n63" value="Сведения о платежах и долгах жильцов — персональные данные и основа для мошенничества." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="201" width="430" height="50" as="geometry"/></mxCell><mxCell id="e64" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n62" target="n63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n65" value="Начисления и платежи за ЖКУ&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;tenant-core-db, платёжная система&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-740" y="129" width="240" height="70" as="geometry"/></mxCell><mxCell id="e66" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n65" target="n56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e67" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n65" target="n59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e68" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n65" target="n62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n69" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-985" y="275" width="170" height="50" as="geometry"/></mxCell><mxCell id="n70" value="Ошибки в учёте искажают отчётность и ведут к налоговым санкциям." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="275" width="430" height="50" as="geometry"/></mxCell><mxCell id="e71" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n69" target="n70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="337" width="170" height="50" as="geometry"/></mxCell><mxCell id="n73" value="Коммерческая тайна: себестоимость, маржа, условия с подрядчиками." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="337" width="430" height="50" as="geometry"/></mxCell><mxCell id="e74" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n72" target="n73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n75" value="Бухгалтерские и финансовые данные компании&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;accountant-service-1&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-740" y="296" width="240" height="70" as="geometry"/></mxCell><mxCell id="e76" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n75" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e77" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n75" target="n72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n78" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-985" y="411" width="170" height="50" as="geometry"/></mxCell><mxCell id="n79" value="По CDC в хранилище стекаются персональные данные всех систем, а доступ аналитиков не ограничен. Это единая точка компрометации." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="411" width="430" height="50" as="geometry"/></mxCell><mxCell id="e80" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n78" target="n79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n81" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="473" width="170" height="50" as="geometry"/></mxCell><mxCell id="n82" value="Ошибки исходных систем копируются в хранилище и множатся в отчётах." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="473" width="430" height="50" as="geometry"/></mxCell><mxCell id="e83" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n81" target="n82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n84" value="Сырые копии данных всех систем в хранилище&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;Хранилище Greenplum, DWH (S3)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-740" y="432" width="240" height="70" as="geometry"/></mxCell><mxCell id="e85" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n84" target="n78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e86" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n84" target="n81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n87" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="547" width="170" height="50" as="geometry"/></mxCell><mxCell id="n88" value="Потерянное бронирование — потерянная сделка и недовольный клиент." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="547" width="430" height="50" as="geometry"/></mxCell><mxCell id="e89" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n87" target="n88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n90" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="-985" y="609" width="170" height="50" as="geometry"/></mxCell><mxCell id="n91" value="Двойное или ошибочное бронирование приводит к конфликту клиентов за один объект." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="-1485" y="609" width="430" height="50" as="geometry"/></mxCell><mxCell id="e92" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n90" target="n91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n93" value="Бронирования и результаты осмотров&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;client-mart-db, client-tour-db&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-740" y="568" width="240" height="70" as="geometry"/></mxCell><mxCell id="e94" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n93" target="n87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e95" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n93" target="n90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n96" value="&lt;b&gt;Конфиденциальные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-430" y="185" width="200" height="60" as="geometry"/></mxCell><mxCell id="e97" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n1" target="n96"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e98" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n96" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e99" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n96" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e100" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n96" target="n65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e101" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n96" target="n75"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e102" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n96" target="n84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e103" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n96" target="n93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n104" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-702" width="170" height="50" as="geometry"/></mxCell><mxCell id="n105" value="История работ нужна для гарантийных обязательств и споров с подрядчиками. Восстановить её по бумагам долго." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-702" width="430" height="50" as="geometry"/></mxCell><mxCell id="e106" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n104" target="n105"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n107" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-640" width="170" height="50" as="geometry"/></mxCell><mxCell id="n108" value="Неверные даты и состав работ в приложении вызывают жалобы собственников и нарушают планирование." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-640" width="430" height="50" as="geometry"/></mxCell><mxCell id="e109" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n107" target="n108"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n110" value="Графики и история текущего и капитального ремонта&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;tenant-core-db&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="-681" width="240" height="70" as="geometry"/></mxCell><mxCell id="e111" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n110" target="n104"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e112" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n110" target="n107"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n113" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="-562" width="170" height="50" as="geometry"/></mxCell><mxCell id="n114" value="Данные приходят по CDC из многих систем, единой точки регистрации клиента нет: дубли и противоречия. На этих данных принимаются решения и планируются ML/AI-сервисы." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-566" width="430" height="59" as="geometry"/></mxCell><mxCell id="e115" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n113" target="n114"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n116" value="&lt;b&gt;Обесценивание&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-490" width="170" height="50" as="geometry"/></mxCell><mxCell id="n117" value="Без Data Governance, каталога и описания данных накопленные данные нельзя использовать. Это прямо блокирует новые продукты на основе данных." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-495" width="430" height="59" as="geometry"/></mxCell><mxCell id="e118" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n116" target="n117"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n119" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-424" width="170" height="50" as="geometry"/></mxCell><mxCell id="n120" value="Отчёты о продажах, спросе и ценах — коммерческая информация, ценная для конкурентов." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-424" width="430" height="50" as="geometry"/></mxCell><mxCell id="e121" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n119" target="n120"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n122" value="Агрегированные отчёты и витрины BI без персональных данных&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;Хранилище Greenplum, DWH (S3), BI&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="-503" width="240" height="70" as="geometry"/></mxCell><mxCell id="e123" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n122" target="n113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e124" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n122" target="n116"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e125" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n122" target="n119"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n126" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="-350" width="170" height="50" as="geometry"/></mxCell><mxCell id="n127" value="Через AD входят менеджеры, бизнес-аналитики и бухгалтерия. Изменение групп AD даёт доступ ко всем системам компании." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-350" width="430" height="50" as="geometry"/></mxCell><mxCell id="e128" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n126" target="n127"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n129" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-288" width="170" height="50" as="geometry"/></mxCell><mxCell id="n130" value="Список сотрудников и их ролей используется для фишинга и социальной инженерии." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-288" width="430" height="50" as="geometry"/></mxCell><mxCell id="e131" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n129" target="n130"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n132" value="Учётные записи сотрудников и оргструктура (без паролей)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;Active Directory&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="-329" width="240" height="70" as="geometry"/></mxCell><mxCell id="e133" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n132" target="n126"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e134" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n132" target="n129"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n135" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-214" width="170" height="50" as="geometry"/></mxCell><mxCell id="n136" value="Без журналов нельзя расследовать инциденты, например показ чужих данных в личном кабинете." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-214" width="430" height="50" as="geometry"/></mxCell><mxCell id="e137" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n135" target="n136"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n138" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-152" width="170" height="50" as="geometry"/></mxCell><mxCell id="n139" value="Злоумышленник, изменивший журналы, скрывает следы атаки и несанкционированного доступа." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-152" width="430" height="50" as="geometry"/></mxCell><mxCell id="e140" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n138" target="n139"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n141" value="Журналы событий и аудита систем&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;все приложения, Keycloak, AD&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="-193" width="240" height="70" as="geometry"/></mxCell><mxCell id="e142" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n141" target="n135"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e143" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n141" target="n138"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n144" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-78" width="170" height="50" as="geometry"/></mxCell><mxCell id="n145" value="Описание интеграций раскрывает слабые места API: уже известно, что партнёры могут получать чужие данные." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-78" width="430" height="50" as="geometry"/></mxCell><mxCell id="e146" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n144" target="n145"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n147" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="-16" width="170" height="50" as="geometry"/></mxCell><mxCell id="n148" value="Единых политик нет, контракты содержат лишние категории данных, включая персональные." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="-16" width="430" height="50" as="geometry"/></mxCell><mxCell id="e149" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n147" target="n148"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n150" value="Контракты API и условия интеграций с поставщиками ЖКХ&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;tenant-core-app, CRM ЖКУ&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="-57" width="240" height="70" as="geometry"/></mxCell><mxCell id="e151" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n150" target="n144"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e152" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n150" target="n147"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n153" value="&lt;b&gt;Внутренние данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="-364" width="200" height="60" as="geometry"/></mxCell><mxCell id="e154" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n153"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e155" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n153" target="n110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e156" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n153" target="n122"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e157" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n153" target="n132"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e158" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n153" target="n141"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e159" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n153" target="n150"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n160" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="108" width="170" height="50" as="geometry"/></mxCell><mxCell id="n161" value="Полный набор документов человека позволяет мошенникам оформить кредит или сделку от его имени. Максимальные штрафы по 152-ФЗ." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="108" width="430" height="50" as="geometry"/></mxCell><mxCell id="e162" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n160" target="n161"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n163" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="170" width="170" height="50" as="geometry"/></mxCell><mxCell id="n164" value="Юридически значимые данные уходят в госорганы через СМЭВ. Ошибка делает сделку недействительной." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="170" width="430" height="50" as="geometry"/></mxCell><mxCell id="e165" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n163" target="n164"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n166" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="232" width="170" height="50" as="geometry"/></mxCell><mxCell id="n167" value="Без истории сделки компания не докажет условия договора в суде и перед госорганами." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="232" width="430" height="50" as="geometry"/></mxCell><mxCell id="e168" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n166" target="n167"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n169" value="Данные онлайн-сделок: паспорт, СНИЛС, ИНН, ипотека, договоры купли-продажи&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;client-mart-app, client-mart-db, СМЭВ&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="240" height="70" as="geometry"/></mxCell><mxCell id="e170" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n169" target="n160"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e171" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n169" target="n163"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e172" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n169" target="n166"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n173" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="306" width="170" height="50" as="geometry"/></mxCell><mxCell id="n174" value="С украденными учётными данными злоумышленник получает доступ ко всем данным под видом легитимного пользователя или сервиса." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="306" width="430" height="50" as="geometry"/></mxCell><mxCell id="e175" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n173" target="n174"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n176" value="&lt;b&gt;Потеря&lt;/b&gt;&lt;br&gt;значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="368" width="170" height="50" as="geometry"/></mxCell><mxCell id="n177" value="Пользователи и сервисы не смогут войти, но секреты можно перевыпустить." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="368" width="430" height="50" as="geometry"/></mxCell><mxCell id="e178" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n176" target="n177"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n179" value="Учётные данные и секреты: хеши паролей, токены, ключи, секреты интеграций&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;auth-db-1, Keycloak, Kubernetes Secrets&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="327" width="240" height="70" as="geometry"/></mxCell><mxCell id="e180" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n179" target="n173"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e181" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n179" target="n176"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n182" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="442" width="170" height="50" as="geometry"/></mxCell><mxCell id="n183" value="Коды и токены управления замком дают физический доступ в квартиру: угроза имуществу и безопасности жильцов." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="442" width="430" height="50" as="geometry"/></mxCell><mxCell id="e184" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n182" target="n183"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n185" value="&lt;b&gt;Искажение&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="504" width="170" height="50" as="geometry"/></mxCell><mxCell id="n186" value="Подмена прав доступа позволяет открыть чужую квартиру или заблокировать вход владельцу." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="504" width="430" height="50" as="geometry"/></mxCell><mxCell id="e187" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n185" target="n186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n188" value="Доступ к «Умному дому»: управление замком квартиры, коды, журнал открытий&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;мобильное приложение собственника&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="463" width="240" height="70" as="geometry"/></mxCell><mxCell id="e189" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n188" target="n182"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e190" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n188" target="n185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n191" value="&lt;b&gt;Утечка&lt;/b&gt;&lt;br&gt;критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="578" width="170" height="50" as="geometry"/></mxCell><mxCell id="n192" value="Прямое хищение денег жильцов. Требования PCI DSS к хранению и передаче карточных данных." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1055" y="578" width="430" height="50" as="geometry"/></mxCell><mxCell id="e193" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n191" target="n192"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n194" value="Платёжные данные: реквизиты карт и платёжные токены&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;платёжная система, мобильное приложение&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="568" width="240" height="70" as="geometry"/></mxCell><mxCell id="e195" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n194" target="n191"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n196" value="&lt;b&gt;Секретные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="230" y="369" width="200" height="60" as="geometry"/></mxCell><mxCell id="e197" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n196"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e198" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n196" target="n169"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e199" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n196" target="n179"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e200" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n196" target="n188"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e201" style="curved=1;endArrow=none;html=1;strokeColor=#888888;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n196" target="n194"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n202" value="&lt;b&gt;Шкала оценки риска&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#e1f5e1&quot;&gt;&amp;nbsp;незначительный&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#ffe6cc&quot;&gt;&amp;nbsp;значительный&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#f8cecc&quot;&gt;&amp;nbsp;критический&amp;nbsp;&lt;/span&gt;&lt;br&gt;Классификация по ISO/IEC 27001/27002" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-210" y="-828" width="420" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>